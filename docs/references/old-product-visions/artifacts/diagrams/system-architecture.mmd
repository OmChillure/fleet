flowchart TB
  subgraph Humans["Humans"]
    OP[Operator / Product owner]
    HITL[Human-in-the-loop reviewer]
  end

  subgraph ControlPlane["Operator service — control plane"]
    API[API + WebSocket gateway]
    CFG[Configuration manager<br/>max agents · secrets · global goal]
    SCH[Scheduler / capacity<br/>spin up · scale · tear down]
    LIFE[Lifecycle manager<br/>tmux / worker processes]
    MON[Monitoring aggregator]
  end

  subgraph DataPlane["Shared state"]
    BOARD[(Task board store)]
    DOCS[(Document repository)]
    MD[Markdown workspaces]
    SECRETS[(Encrypted secrets<br/>Postgres / SQLite)]
    MONGO[(Document store<br/>MongoDB optional)]
  end

  subgraph Workers["Worker fleet"]
    W1[Worker agent 1]
    W2[Worker agent 2]
    WN[Worker agent N]
  end

  subgraph Targets["Work targets"]
    REPO[Git repositories]
    EXT[External systems<br/>email · CRM · analysis]
  end

  OP --> API
  HITL --> API
  API --> CFG
  API --> SCH
  API --> LIFE
  API --> MON
  SCH --> LIFE
  LIFE --> W1 & W2 & WN
  W1 & W2 & WN <--> BOARD
  W1 & W2 & WN <--> DOCS
  W1 & W2 & WN <--> MD
  CFG --> SECRETS
  W1 & W2 & WN --> REPO & EXT
  W1 & W2 & WN -->|status · artifacts · screenshots| MON
  MON --> API
