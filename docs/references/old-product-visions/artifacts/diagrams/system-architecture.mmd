flowchart TB
  subgraph Platform["Platform"]
    AUTH[Auth / membership]
    ORGreg[Organization registry]
  end

  subgraph Org["Organization"]
    MEM[Members & roles]
    TPOL[Organization policies · quotas]
    INT[Board integrations · Jira · Monday · …]
    PROJS[Projects]
  end

  subgraph Project["Project — isolation boundary for work"]
    subgraph ControlPlane["Project orchestrator / operator"]
      API[API + WebSocket gateway]
      CFG[Configuration manager<br/>max agents · secrets · project goal]
      SCH[Scheduler / capacity]
      LIFE[Lifecycle manager]
      MON[Monitoring aggregator]
    end

    subgraph DataPlane["Project data"]
      DOCTREE[(Document tree)]
      BOARD[(Task board)]
      MD[Markdown workspaces]
      SECRETS[(Encrypted secrets)]
    end

    subgraph Workers["Project worker fleet"]
      W1[Worker 1]
      W2[Worker 2]
      WN[Worker N]
    end
  end

  subgraph Targets["Work targets"]
    REPO[Git repositories]
    EXT[External systems]
  end

  AUTH --> ORGreg
  ORGreg --> Org
  MEM --> PROJS
  PROJS --> Project
  API --> CFG & SCH & LIFE & MON
  SCH --> LIFE
  LIFE --> W1 & W2 & WN
  W1 & W2 & WN <--> DOCTREE & BOARD & MD
  CFG --> SECRETS
  W1 & W2 & WN --> REPO & EXT
  W1 & W2 & WN -->|status · artifacts| MON
