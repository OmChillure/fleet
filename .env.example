# Agent Fleet local env — copy to `.env` and edit.
#   Backend:  cargo run                              → http://localhost:8080
#   Frontend: dx serve --package fleet-ui --port 3030 → http://localhost:3030
#   Orchestrator: cargo run -p fleet-orchestrator
#
# Neon example (TLS required; workspace sqlx enables rustls):
#   postgres://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Logging — standard RUST_LOG levels (default: info):
#   RUST_LOG=info   normal ops + HTTP + errors (default if unset)
#   RUST_LOG=debug  verbose (JWT, request start, query detail, …)
#   RUST_LOG=warn   quiet — only warnings and errors
# Per-crate: RUST_LOG=info,fleet_integrations=debug,sqlx=error
# RUST_LOG=info

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/agent_fleet

# JWT signing secret — use a long random string in production (≥ 32 chars)
JWT_SECRET=dev-change-me-to-a-long-random-secret-at-least-32-chars

JWT_ACCESS_TTL_SECS=900
JWT_REFRESH_TTL_SECS=604800

# AES-256 key for OAuth tokens at rest (AES-GCM envelopes in Postgres).
# Prefer a dedicated key in production:  openssl rand -hex 32
# If unset, the server derives a key from JWT_SECRET (dev-only; logs a warning).
# INTEGRATIONS_ENCRYPTION_KEY=

# fleet-server bind (numeric host required for SocketAddr — not the string "localhost")
HOST=127.0.0.1
PORT=8080

# UI origins allowed to call the API with cookies (credentials CORS)
CORS_ORIGINS=http://localhost:3030,http://127.0.0.1:3030

COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

API_PUBLIC_BASE=http://localhost:8080
UI_PUBLIC_BASE=http://localhost:3030

# --- fleet-orchestrator (control plane) ---
# Compose helper: postgres://fleet:fleet@localhost:5433/fleet?sslmode=disable
DATA_DIR=./data
SANDBOX_BACKEND=stub
# SANDBOX_BACKEND=process
# PROCESS_WORKER_BIN=./target/debug/fleet-worker
# FLEET_WORK_CMD=          # optional shell work for fleet-worker (else run.sh / artifacts)
# Workers POST heartbeats to API_PUBLIC_BASE (or ORCHESTRATOR_PUBLIC_URL).
# Do not leave this as http://0.0.0.0:8080 — rewrite is applied automatically.
STUB_DURATION_S=0
# AUTO_SYNC_EXTERNAL=false   # process default; enable per-project for PR10 tick sync
# Optional: enable /v1 bearer automation (not needed for UI — uses login cookies)
# ADMIN_TOKEN=dev-admin-token-change-me

# --- Integrations OAuth (optional on the server) ---
# Connect always starts the provider login. If these env vars are unset:
#   GitHub — first Connect creates a workspace GitHub App, then install/consent
#   Jira   — first Connect asks for an Atlassian OAuth app, then consent
# Env vars below, when set, skip that first-time step.
# Create an OAuth app on each platform; callback URL must be exactly:
#   {API_PUBLIC_BASE}/api/integrations/oauth/callback/{provider}
# Examples:
#   http://localhost:8080/api/integrations/oauth/callback/github
#   http://localhost:8080/api/integrations/oauth/callback/slack
#   http://localhost:8080/api/integrations/oauth/callback/linear
#   http://localhost:8080/api/integrations/oauth/callback/jira
#   http://localhost:8080/api/integrations/oauth/callback/figma
#   http://localhost:8080/api/integrations/oauth/callback/notion
#   http://localhost:8080/api/integrations/oauth/callback/google_drive
#   http://localhost:8080/api/integrations/oauth/callback/teams
#   http://localhost:8080/api/integrations/oauth/callback/discord

# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=

# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=

# JIRA_CLIENT_ID=
# JIRA_CLIENT_SECRET=

# FIGMA_CLIENT_ID=
# FIGMA_CLIENT_SECRET=

# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=

# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=

# TEAMS_CLIENT_ID=
# TEAMS_CLIENT_SECRET=

# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
