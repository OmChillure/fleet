# Agent Fleet local env — copy to `.env` and edit.
#
# Host install (PROFILE / ENABLE_*): see
#   crates/fleet-sandbox-driver/sandbox-lab/scripts/install-full-suite-deps.sh
# PROFILE=full
# ENABLE_KIND=1
# ENABLE_FULL_IMAGES=1
# ENABLE_SANDBOX_LAB=1
# ENABLE_BROWSER_E2E=1   # playwright + Chromium; run-full-suite.sh browser-e2e
# ENABLE_RUNNER_GUEST_E2E=1  # VM/OS matrix; docs/components/runners/testing-procedures.md
# OLLAMA_MODEL=llama3.2:1b
#   Backend:  cargo run                              → http://localhost:8080
#   Frontend: dx serve --package fleet-ui --port 3030 → http://localhost:3030
#   Orchestrator: cargo run -p fleet-orchestrator
#
# Start:
#   cargo run                                      → API  http://localhost:8080
#   dx serve --package fleet-ui --port 3030        → UI   http://localhost:3030

# ── Required ──────────────────────────────────────────────────────────────────

# Postgres. Hosted (Supabase/Neon): add ?sslmode=require.
# Supabase: session pooler :5432 (transaction :6543 is rewritten to :5432).
# Optional: DATABASE_ACQUIRE_TIMEOUT_SECS=90
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/agent_fleet

# Must be at least 32 characters
JWT_SECRET=dev-change-me-to-a-long-random-secret-at-least-32-chars

# Shared invite for POST /api/auth/signup. Unset = open signup (local/dev).
# Production must set this. The signup form sends it when filled.
# SIGNUP_TOKEN=

# Comma-separated emails granted users.instance_admin on signup/login.
# Distinct from workspace role admin. Unset = nobody until an admin promotes
# someone (or scripts/promote-instance-admin.sh).
# INSTANCE_ADMIN_EMAILS=you@example.test

# Shared secret so compose/kind/local fleet-host can pair without a UI token.
# Unset on the API → POST /api/worker-hosts/bootstrap is 404.
# FLEET_BOOTSTRAP_SECRET=   # unset unless you run cluster hosts; never ship the published default

# ── Server ────────────────────────────────────────────────────────────────────

HOST=127.0.0.1
PORT=8080

# Where the API and UI are reachable (OAuth redirects + cookies)
API_PUBLIC_BASE=http://localhost:8080
UI_PUBLIC_BASE=http://localhost:3030
CORS_ORIGINS=http://localhost:3030,http://127.0.0.1:3030

COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# ── Chat (optional) ───────────────────────────────────────────────────────────

# Local models: install Ollama, then `ollama pull llama3.2`
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_ENABLED=true

# Cloud Grok: run `grok login` (uses ~/.grok/auth.json) or set an API key
# GROK_ENABLED=true

# Cases: LLM invents the next action when Grok or Ollama is on.
# CASE_LLM_DECIDE=0 forces the wait/observe heuristic.
# CASE_WAKE_INTERVAL_S=15
# XAI_API_KEY=
# OPENAI_API_KEY=
# OPENAI_MODELS=gpt-4o-mini,gpt-4o
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODELS=claude-sonnet-4-6,claude-opus-4-6,claude-haiku-4-5

# ── Sandboxes (jobs run on a paired fleet-host) ───────────────────────────────
# The API is not a runner. Tick assigns to an online fleet-host or leaves
# the task ready.
DATA_DIR=./data
# K8S_NAMESPACE=agent-fleet
# K8S_WORKER_IMAGE=agent-fleet-api:local
# K8S_WORKER_COMMAND=fleet-driver
# K8S_WORKER_API_URL=http://api.agent-fleet.svc.cluster.local:8080
# Hybrid (host API + cluster): a host IP pods can route, e.g. the kind bridge
# gateway. DNS names are not NetworkPolicy CIDRs.
# K8S_WORKER_API_URL=http://172.18.0.1:8080
# Workers POST heartbeats to API_PUBLIC_BASE (or ORCHESTRATOR_PUBLIC_URL).
# Do not leave this as http://0.0.0.0:8080 — rewrite is applied automatically.
# Loopback is OK for a worker on this box. Off-box pair needs a reachable URL
# (the UI warns; spawn still assigns — not fail-closed in v1).
# AUTO_SYNC_EXTERNAL=false   # process default; Inbox monitor/finish turns this on per workspace
# Slack channel (id or #name) for HITL blocked + run done. Needs Slack connected.
# FLEET_NOTIFY_SLACK_CHANNEL=#fleet
# Optional: enable /v1 bearer automation (not needed for UI — uses login cookies)
# ADMIN_TOKEN=dev-admin-token-change-me

# Concurrent jobs across paired hosts. Extra tasks *queue* until a slot frees.
# Hard max 256. Live count is workspace Settings → Number of agents.
# FLEET_MAX_AGENTS=16
# TICK_INTERVAL_S=5
# Optional: local path or git URL — each sandbox gets its own worktree under work_dir/repo
# FLEET_GIT_SOURCE=/path/to/your/repo

# Grok workers only (env — not in the Settings UI). Requires grok login / XAI_API_KEY.
# FLEET_AGENT_BACKEND=grok
# FLEET_AGENT_MAX_ROUNDS=10
# FLEET_PERSONAS_DIR=./data/agency-agents
# Local Ollama fleet LLM + model are chosen in UI Settings (/{workspace}/settings).
# First launch clones https://github.com/msitarzewski/agency-agents

# ── Integrations OAuth (optional) ─────────────────────────────────────────────
# Connect always starts the provider login. If these env vars are unset:
#   GitHub — first Connect creates a workspace GitHub App, then install/consent
#   Jira   — first Connect asks for an Atlassian OAuth app, then consent
# Env vars below, when set, skip that first-time step.

# Encrypts connected-app tokens in the DB.
# Generate: openssl rand -hex 32
# If unset, falls back to JWT_SECRET (fine for local only)
# INTEGRATIONS_ENCRYPTION_KEY=

# Callback to register on every OAuth app:
#   http://localhost:8080/api/integrations/oauth/callback/{provider}
#   e.g. .../callback/github

# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=
# JIRA_CLIENT_ID=
# JIRA_CLIENT_SECRET=
# FIGMA_CLIENT_ID=
# FIGMA_CLIENT_SECRET=
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# TEAMS_CLIENT_ID=
# TEAMS_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# TRELLO_CLIENT_ID=
# TRELLO_CLIENT_SECRET=
# ASANA_CLIENT_ID=
# ASANA_CLIENT_SECRET=

# Optional: prebuilt worker binaries served at /install/worker/bin/{platform}/{bin}
# FLEET_WORKER_DIST_DIR=
# Official download base shown by install-worker.sh (empty → prompt / require FLEET_URL)
# FLEET_OFFICIAL_BASE=
