# Agent Fleet local env — copy to `.env` and edit.
#   Backend:  cargo run                              → http://localhost:8080
#   Frontend: dx serve --package fleet-ui --port 3030 → http://localhost:3030
#
# Neon example (TLS required; workspace sqlx enables rustls):
#   postgres://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/agent_fleet

# JWT signing secret — use a long random string in production (≥ 32 chars)
JWT_SECRET=dev-change-me-to-a-long-random-secret-at-least-32-chars

JWT_ACCESS_TTL_SECS=900
JWT_REFRESH_TTL_SECS=604800

# fleet-server bind (numeric host required for SocketAddr — not the string "localhost")
HOST=127.0.0.1
PORT=8080

# UI origins allowed to call the API with cookies (credentials CORS)
CORS_ORIGINS=http://localhost:3030,http://127.0.0.1:3030

COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
