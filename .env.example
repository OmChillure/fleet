# Agent Fleet local env — copy to `.env` and edit.
#
# Host install (PROFILE / ENABLE_*): see
#   crates/fleet-sandbox-driver/sandbox-lab/scripts/install-full-suite-deps.sh
# PROFILE=full
# ENABLE_KIND=1
# ENABLE_FULL_IMAGES=1
# ENABLE_SANDBOX_LAB=1
# OLLAMA_MODEL=llama3.2:1b
#   Backend:  cargo run                              → http://localhost:8080
#   Frontend: dx serve --package fleet-ui --port 3030 → http://localhost:3030
#   Orchestrator: cargo run -p fleet-orchestrator
#
# Start:
#   cargo run                                      → API  http://localhost:8080
#   dx serve --package fleet-ui --port 3030        → UI   http://localhost:3030

# ── Required ──────────────────────────────────────────────────────────────────

# Postgres (add ?sslmode=require for Neon/Supabase)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/agent_fleet

# Must be at least 32 characters
JWT_SECRET=dev-change-me-to-a-long-random-secret-at-least-32-chars

# ── Server ────────────────────────────────────────────────────────────────────

HOST=127.0.0.1
PORT=8080

# Where the API and UI are reachable (OAuth redirects + cookies)
API_PUBLIC_BASE=http://localhost:8080
UI_PUBLIC_BASE=http://localhost:3030
CORS_ORIGINS=http://localhost:3030,http://127.0.0.1:3030

COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# ── Chat (optional) ───────────────────────────────────────────────────────────

# Local models: install Ollama, then `ollama pull llama3.2`
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_ENABLED=true

# Cloud Grok: run `grok login` (uses ~/.grok/auth.json) or set an API key
# GROK_ENABLED=true
# XAI_API_KEY=

# ── Sandboxes (agent command runners) ─────────────────────────────────────────

# stub    = fake (default, good for UI demos)
# process = real bash in ./data/.../sessions (best for local dev)
# docker  = real container (needs Docker)
DATA_DIR=./data
SANDBOX_BACKEND=stub
# SANDBOX_BACKEND=process
# PROCESS_WORKER_BIN=./target/debug/fleet-worker
# FLEET_WORK_CMD=          # optional shell work for fleet-worker (else run.sh / artifacts)
# Workers POST heartbeats to API_PUBLIC_BASE (or ORCHESTRATOR_PUBLIC_URL).
# Do not leave this as http://0.0.0.0:8080 — rewrite is applied automatically.
STUB_DURATION_S=0
# AUTO_SYNC_EXTERNAL=false   # process default; enable per-project for PR10 tick sync
# Optional: enable /v1 bearer automation (not needed for UI — uses login cookies)
# ADMIN_TOKEN=dev-admin-token-change-me

# Concurrent local sandboxes (no k8s). Extra tasks *queue* until a slot frees.
# Hard max 256. Plans may contain up to 1000 tasks.
# FLEET_MAX_AGENTS=16
# TICK_INTERVAL_S=5
# Optional: local path or git URL — each sandbox gets its own worktree under work_dir/repo
# FLEET_GIT_SOURCE=/path/to/your/repo

# Only used when SANDBOX_BACKEND=docker
# SANDBOX_DOCKER_IMAGE=alpine:3.20
# SANDBOX_DOCKER_NETWORK=none

# ── Integrations OAuth (optional) ─────────────────────────────────────────────

# Encrypts connected-app tokens in the DB.
# Generate: openssl rand -hex 32
# If unset, falls back to JWT_SECRET (fine for local only)
# INTEGRATIONS_ENCRYPTION_KEY=

# Callback to register on every OAuth app:
#   http://localhost:8080/api/integrations/oauth/callback/{provider}
#   e.g. .../callback/github

# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=
# JIRA_CLIENT_ID=
# JIRA_CLIENT_SECRET=
# FIGMA_CLIENT_ID=
# FIGMA_CLIENT_SECRET=
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# TEAMS_CLIENT_ID=
# TEAMS_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
