# Copy to `.env` and fill in (Neon, Supabase, or local Postgres).
# Example Neon:  postgres://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/agent_fleet

# JWT signing secret — use a long random string in production (≥ 32 chars)
JWT_SECRET=dev-change-me-to-a-long-random-secret-at-least-32-chars

JWT_ACCESS_TTL_SECS=900
JWT_REFRESH_TTL_SECS=604800

# Unified fleet-server bind (cargo run) — backend on 8080
HOST=127.0.0.1
PORT=8080

# Frontend is dx serve on 3030 — allow cookie CORS from the UI origin
CORS_ORIGINS=http://localhost:3030,http://127.0.0.1:3030

COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
