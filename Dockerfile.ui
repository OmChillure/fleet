# syntax=docker/dockerfile:1
# fleet-ui — Dioxus WASM build served by nginx (proxies /api → api service)
#
#   docker build --build-arg FLEET_GIT_SHA=$(./scripts/tree-id.sh) -f Dockerfile.ui -t agent-fleet-ui:local .
#   docker compose up -d --build ui
#
# dioxus-cli install stays before ARG so a dirty tree-id does not reinstall dx.
# cargo fetch warms the registry before ARG. dx build sees FLEET_GIT_SHA.

FROM rust:1.88-bookworm AS builder

RUN rustup target add wasm32-unknown-unknown \
    && cargo install dioxus-cli --version 0.7.3 --locked \
    && apt-get update \
    && apt-get install -y --no-install-recommends binaryen \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo fetch --locked

# SHA after dx install + fetch so a dirty tree-id does not bust those layers.
ARG FLEET_GIT_SHA
RUN test -n "${FLEET_GIT_SHA}" || (echo "ERROR: --build-arg FLEET_GIT_SHA=\$(git rev-parse HEAD) is required" && exit 1)
ENV FLEET_GIT_SHA=${FLEET_GIT_SHA}

# Release web build (static assets under target/dx/.../web/public)
# Same-origin /api via nginx — do NOT set FLEET_AUTH_URL so the browser uses page origin.
# /fleet-git-sha.txt is a static identity probe (no WASM). Old images 404 / SPA-fallback.
# The UI target cache is separate from the API image (id=fleet-ui-dx) so
# wiping it cannot delete fleet-driver. dx otherwise republishes the
# previous wasm under a new git sha. Hash the UI sources and drop that
# cache when they change. fleet-git-sha.txt is written after the hash so
# a sha-only rebuild does not wipe the cache.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,id=fleet-ui-dx,target=/app/target \
    src_hash="$(find crates/fleet-ui crates/fleet-chat-md crates/fleet-runners-view -type f \
        ! -path 'crates/fleet-ui/public/fleet-git-sha.txt' \
        -print0 | sort -z | xargs -0 sha256sum | sha256sum | awk '{print $1}')" \
    && stamp=/app/target/.fleet-ui-src-hash \
    && if [ "$(cat "$stamp" 2>/dev/null || true)" != "$src_hash" ]; then \
         echo "fleet-ui sources changed; dropping cached fleet-ui wasm"; \
         rm -rf \
           /app/target/wasm32-unknown-unknown/wasm-release/deps/libfleet_ui-* \
           /app/target/wasm32-unknown-unknown/wasm-release/deps/fleet_ui-* \
           /app/target/wasm32-unknown-unknown/wasm-release/.fingerprint/fleet-ui-* \
           /app/target/wasm32-unknown-unknown/wasm-release/deps/libfleet_chat_md-* \
           /app/target/wasm32-unknown-unknown/wasm-release/deps/fleet_chat_md-* \
           /app/target/wasm32-unknown-unknown/wasm-release/.fingerprint/fleet-chat-md-* \
           /app/target/wasm32-unknown-unknown/wasm-release/deps/libfleet_runners_view-* \
           /app/target/wasm32-unknown-unknown/wasm-release/deps/fleet_runners_view-* \
           /app/target/wasm32-unknown-unknown/wasm-release/.fingerprint/fleet-runners-view-* \
           /app/target/dx; \
       fi \
    && mkdir -p /app/target \
    && grep -q 'Reconnect' crates/fleet-ui/src/pages/integrations/connection.rs \
    && mkdir -p crates/fleet-ui/public \
    && printf '%s\n' "${FLEET_GIT_SHA}" > crates/fleet-ui/public/fleet-git-sha.txt \
    && CARGO_PROFILE_RELEASE_DEBUG=0 dx build --package fleet-ui --release --platform web \
    && PUBLIC="$(find target -type f -path '*/web/public/index.html' | head -1 | xargs dirname)" \
    && test -n "$PUBLIC" \
    && echo "UI public dir: $PUBLIC" \
    && rm -rf /out \
    && mkdir -p /out \
    && cp -a "$PUBLIC"/. /out/ \
    && printf '%s\n' "${FLEET_GIT_SHA}" > /out/fleet-git-sha.txt \
    && test "$(tr -d '[:space:]' < /out/fleet-git-sha.txt)" = "${FLEET_GIT_SHA}" \
    && js="$(grep -o 'assets/fleet-ui-[^"]*\.js' /out/index.html | head -1)" \
    && test -n "$js" \
    && wasm="$(grep -o 'fleet-ui_bg-[^"]*\.wasm' "/out/${js}" | head -1)" \
    && test -n "$wasm" \
    && grep -a -q 'Reconnect' "/out/assets/${wasm}" \
    && printf '%s\n' "$src_hash" > "$stamp"

FROM nginx:1.27-alpine AS runtime

ARG FLEET_GIT_SHA
RUN test -n "${FLEET_GIT_SHA}"
LABEL fleet.git_sha=${FLEET_GIT_SHA}

COPY deploy/nginx-ui.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /out/ /usr/share/nginx/html/

# nginx base image listens on 80 by default; our conf uses 3030 only
RUN rm -f /etc/nginx/conf.d/default.conf.bak 2>/dev/null; true

EXPOSE 3030

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=5 \
  CMD wget -q -O /dev/null http://127.0.0.1:3030/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
