# Copied to the VPS once by scripts/bootstrap-vps.sh.
# Deploy never overwrites this file. Edit on the VPS to change secrets or URLs.

POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-must-be-at-least-32-characters-long
FLEET_BOOTSTRAP_SECRET=change-me
INTEGRATIONS_ENCRYPTION_KEY=change-me

API_PUBLIC_BASE=https://agentfleet.studio
UI_PUBLIC_BASE=https://agentfleet.studio
CORS_ORIGINS=https://agentfleet.studio

COOKIE_SECURE=true
COOKIE_SAMESITE=Lax

# API is not a runner. Pair a fleet-host for jobs.
FLEET_HARNESS=mock
# Required on the signup form when set. Leave empty to allow open signup (local).
SIGNUP_TOKEN=change-me

# No longer grants admin on signup. Promote with scripts/promote-instance-admin.sh.
# INSTANCE_ADMIN_EMAILS=

# Outbound mail (Resend). Inbound is Cloudflare Email Routing — see mail.md.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
SMTP_PASSWORD=re_replace_me
SMTP_FROM=Agent Fleet <noreply@mail.agentfleet.studio>
SMTP_REPLY_TO=hello@agentfleet.studio
RESEND_API_KEY=re_replace_me
