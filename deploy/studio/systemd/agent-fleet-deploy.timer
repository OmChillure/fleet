[Unit]
Description=Poll GitLab main and spawn a Grok deploy session every 5 minutes

[Timer]
# OnCalendar + Persistent survives reboot. OnBootSec/OnUnitActiveSec
# do not catch up (Persistent only applies to OnCalendar), so after a
# reboot the timer went elapsed and never fired again.
OnCalendar=*-*-* *:0/5:00
AccuracySec=1s
Persistent=true
Unit=agent-fleet-deploy.service

[Install]
WantedBy=timers.target
