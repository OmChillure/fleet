{
  "$schema": "https://opencode.ai/config.json",
  "model": "myprovider/my-model",
  "provider": {
    "myprovider": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "My OpenAI-compatible provider",
      "options": {
        "baseURL": "https://api.example.com/v1",
        "apiKey": "{env:OPENCODE_API_KEY}"
      },
      "models": {
        "my-model": {
          "name": "My Model"
        }
      }
    }
  }
}
