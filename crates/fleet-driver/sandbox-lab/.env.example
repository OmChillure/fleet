# Agent Fleet sandbox-lab — per-developer copy:
#   cp .env.example .env

# --- Queue (Redis = lab bus) -------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_URL_HOST=redis://127.0.0.1:6379/0
FLEET_JOBS_QUEUE=fleet:jobs
FLEET_RESULTS_QUEUE=fleet:results

# --- Harness -----------------------------------------------------------------
# Default ONLY for seed-from-env / jobs that omit "harness".
# Per-task jobs set harness in the JSON (opencode vs pi vs …) — that wins.
# Do not rely on this for dual runs; each job file picks its harness + image.
# opencode | pi | codex | grok | custom
HARNESS=opencode

# --- Git ---------------------------------------------------------------------
GIT_REPO_URL=https://github.com/octocat/Hello-World.git
GIT_REF=master
SSH_KEY_HOST_PATH=/tmp/fleet-lab-ssh/id_ed25519

# --- OpenCode provider (general — not LM Studio specific) --------------------
# Prefer job JSON `provider` / full `opencode` config. Env fallback:
# OPENCODE_PROVIDER_ID=myprovider
# OPENCODE_PROVIDER_NAME=My Provider
# OPENCODE_PROVIDER_NPM=@ai-sdk/openai-compatible
# OPENCODE_BASE_URL=https://api.example.com/v1
# OPENCODE_API_KEY=sk-...
# MODEL=myprovider/my-model
#
# LM Studio example (OpenAI-compatible custom provider):
OPENCODE_PROVIDER_ID=lmstudio
OPENCODE_PROVIDER_NAME=LM Studio (local)
OPENCODE_BASE_URL=http://host.docker.internal:1234/v1
OPENCODE_API_KEY=lm-studio
MODEL=lmstudio/google/gemma-4-e4b
# If host.docker.internal fails from the container, use your host LAN IP.

# Built-in providers (optional):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MODEL=anthropic/claude-sonnet-4-5

# --- Job defaults ------------------------------------------------------------
ANALYZE_PROMPT=Analyze this repository. Summarize purpose, layout, main languages, and how to build/test. Be concise (under 40 lines).
JOB_TIMEOUT_SEC=600
AUTO_SEED_JOB=0
FLEET_DRIVER_LOOP=0

# volume = project setup in workspace container (recommended)
# local  = clone inside harness (fallback / unit tests)
FLEET_PROVISION_MODE=volume
FLEET_DIR=/workspace/.fleet
# Shared by driver + workspace agent only (stripped from ACP harness env).
FLEET_HANDSHAKE_SECRET=dev-lab-handshake-not-for-prod
