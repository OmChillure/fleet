{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-fleet.local/schemas/workplan.v1.json",
  "title": "WorkPlan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_id", "project_id", "run_id", "version", "status", "source", "tasks", "policy"],
  "properties": {
    "plan_id": { "type": "string", "format": "uuid" },
    "project_id": { "type": "string", "format": "uuid" },
    "run_id": { "type": "string", "format": "uuid" },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "type": "string", "enum": ["draft", "ready", "accepted", "superseded"] },
    "source": { "type": "string", "minLength": 1 },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["plan_task_id", "title", "worker_profile"],
        "properties": {
          "plan_task_id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string" },
          "spec_md": { "type": "string", "maxLength": 65536 },
          "depends_on": {
            "type": "array",
            "maxItems": 32,
            "items": { "type": "string" }
          },
          "worker_profile": { "type": "string", "minLength": 1 },
          "acceptance": { "type": "array", "items": { "type": "string" } },
          "priority": { "type": "integer" },
          "external_ref": {
            "type": "object",
            "properties": {
              "provider": { "type": "string" },
              "key": { "type": "string" }
            }
          },
          "timeout_s": { "type": "integer", "minimum": 1 },
          "max_retries": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_agents_override": { "type": ["integer", "null"], "minimum": 1 },
        "on_task_fail": { "type": "string", "enum": ["fail_run", "leave"] },
        "auto_sync_external": { "type": "boolean" }
      }
    }
  }
}
